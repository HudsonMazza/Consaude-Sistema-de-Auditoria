rules_version = '2';

// Security Rules do ConSaúde — Auditoria Médica.
//
// Estas regras rodam nos servidores do Google. Nada aqui pode ser contornado
// pelo navegador: mesmo que alguém edite o JavaScript, o Firestore recusa a
// operação. O papel (admin/user) mora aqui, não no cliente.
//
// Publicar:  firebase deploy --only firestore:rules
// Ou colar em: Console → Firestore Database → Regras.

service cloud.firestore {
  match /databases/{database}/documents {

    function autenticado() {
      return request.auth != null;
    }

    function meuPerfil() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function perfilExiste() {
      return autenticado()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    // Um usuário desativado tem sessão válida no Auth, mas perde todo o acesso.
    function ativo() {
      return perfilExiste() && meuPerfil().disabled != true;
    }

    function admin() {
      return ativo() && meuPerfil().role == 'admin';
    }

    function roleValido(dados) {
      return dados.role == 'admin' || dados.role == 'user';
    }

    match /users/{uid} {
      // Cada um enxerga o próprio perfil; admins enxergam todos.
      allow read: if autenticado() && (request.auth.uid == uid || admin());

      allow create: if admin()
        && roleValido(request.resource.data)
        && request.resource.data.disabled == false;

      allow update: if
        // Admin edita nome, cargo, papel e ativação de qualquer conta — menos o próprio
        // papel e a própria ativação (evita um admin se trancar para fora sem querer).
        (
          admin()
          && roleValido(request.resource.data)
          && request.resource.data.email == resource.data.email
          && (request.auth.uid != uid
              || (request.resource.data.role == resource.data.role
                  && request.resource.data.get('disabled', false) == resource.data.get('disabled', false)))
        )
        ||
        // O próprio usuário só ajusta nome/cargo/foto e baixa o flag de troca de
        // senha. Não consegue se promover a admin nem se reativar. A foto tem
        // teto de tamanho para não estourar o limite de 1 MB do documento.
        (
          request.auth.uid == uid
          && ativo()
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['name', 'cargo', 'mustChangePassword', 'photo'])
          && request.resource.data.get('mustChangePassword', false) == false
          && (request.resource.data.get('photo', null) == null
              || request.resource.data.photo.size() < 500000)
        );

      // Exclusão definitiva só pelo Console do Firebase — o app desativa.
      allow delete: if false;
    }

    function auditoriaValida(dados) {
      return dados.userId is string && dados.resultados is map;
    }

    match /audits/{auditId} {
      // Cada um enxerga as próprias auditorias; admins enxergam todas.
      allow read: if ativo() && (admin() || resource.data.userId == request.auth.uid);

      // Admin pode criar em nome de outro userId (migração do histórico legado).
      allow create: if ativo()
        && (admin() || request.resource.data.userId == request.auth.uid)
        && auditoriaValida(request.resource.data);

      // Updates permitidos pelo app: anexar o relatório de IA depois de gerado e
      // salvar os status de revisão (Revisado/Corrigido) por médico. Teto de tamanho
      // pela mesma razão do `photo` em users/{uid}.
      allow update: if ativo()
        && (admin() || resource.data.userId == request.auth.uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['aiReportHTML', 'statuses'])
        && (!('aiReportHTML' in request.resource.data)
            || (request.resource.data.aiReportHTML is string
                && request.resource.data.aiReportHTML.size() < 900000))
        && (!('statuses' in request.resource.data)
            || (request.resource.data.statuses is map
                && request.resource.data.statuses.size() <= 5000));

      allow delete: if ativo() && (admin() || resource.data.userId == request.auth.uid);
    }

    // Arquivos originais de cada auditoria (Produção e Repasse), guardados sem alteração para rastreabilidade.
    // Cada documento carrega o userId de quem enviou, então a regra não precisa ler a auditoria. São imutáveis:
    // só podem ser criados (na hora da auditoria) e apagados (junto com a auditoria) — nunca editados.
    match /audits/{auditId}/arquivos/{chave} {
      allow read, delete: if ativo() && (admin() || resource.data.userId == request.auth.uid);
      allow create: if ativo()
        && (admin() || request.resource.data.userId == request.auth.uid)
        && (chave == 'prod' || chave == 'rep')
        && request.resource.data.chave == chave
        && request.resource.data.nome is string
        && request.resource.data.tamanho is number
        && request.resource.data.partes is number
        && request.resource.data.partes >= 1 && request.resource.data.partes <= 20;
      allow update: if false;
    }

    match /audits/{auditId}/arquivoPartes/{parteId} {
      allow read, delete: if ativo() && (admin() || resource.data.userId == request.auth.uid);
      allow create: if ativo()
        && (admin() || request.resource.data.userId == request.auth.uid)
        && request.resource.data.dados is string
        && request.resource.data.dados.size() <= 700000;
      allow update: if false;
    }

    // Nenhuma outra coleção é acessível por padrão.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
