# Firebase — Console → ⚙ Configurações do projeto → Seus apps → SDK setup and configuration
# Estas chaves são públicas por design (vão no bundle). A proteção real está em
# firestore.rules e na verificação de senha feita pelo Firebase Auth.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=seu-projeto.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=seu-projeto
VITE_FIREBASE_STORAGE_BUCKET=seu-projeto.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ATENÇÃO: esta chave é embutida no bundle e fica visível para qualquer visitante.
# Enquanto a chamada à OpenAI não for movida para um backend, use uma chave com
# limite de gasto baixo e rotacione com frequência.
VITE_OPENAI_API_KEY=

# Cloudflare R2 — configure somente no ambiente do servidor (Vercel/local).
# Nunca use o prefixo VITE_ e nunca versione o arquivo .env com valores reais.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=consaude-planilhas
R2_ENDPOINT=https://SEU_ACCOUNT_ID.r2.cloudflarestorage.com

# Limite por planilha guardada no R2 (20 MB por padrão; acompanhe ARQUIVO_MAX_MB em src/lib/auditFiles.js).
MAX_UPLOAD_SIZE_MB=20
